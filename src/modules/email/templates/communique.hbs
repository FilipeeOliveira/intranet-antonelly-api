<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>

  <style>
    body { margin: 0; padding: 0; width: 100% !important; background-color: #F2F4F6; }
    table { border-collapse: collapse; }
    img { border: 0; height: auto; }
    p { margin: 0; }

    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; }
      .p-mobile { padding: 24px 20px !important; }
      .stack { display: block !important; width: 100% !important; }
    }
  </style>
</head>

<body style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1F2937;">

  <!-- Preheader -->
  <div style="display:none; font-size:1px; color:#F2F4F6;">
    {{title}} — novo comunicado interno.
  </div>

  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 40px 12px;">

        <table class="email-container" width="600" style="background:#FFFFFF; border-radius:10px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,.08);">

          <!-- Header verde -->
          <tr>
            <td class="p-mobile" style="background-color:#10b981; padding:28px 40px;">
              <table width="100%">
                <tr>
                  <td class="stack" valign="middle">
                    <h1 style="margin:0; font-size:24px; line-height:30px; font-weight:800; color:#FFFFFF;">
                      Comunicado Interno
                    </h1>
                  </td>
                  <td class="stack" valign="middle" align="right">
                    <span style="display:inline-block; padding:6px 14px; font-size:12px; font-weight:800; border-radius:999px; background-color:#059669; color:#FFFFFF; text-transform:uppercase;">
                      Atenção
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Espaçamento extra abaixo do header -->
          <tr>
            <td height="24" style="background:#FFFFFF;"></td>
          </tr>

          <!-- Conteúdo principal -->
          <tr>
            <td class="p-mobile" style="padding: 0 40px 36px;">

              {{#if isUpdate}}
              <div style="margin-bottom:16px;">
                <span style="background:#ECFDF5; color:#047857; border:1px solid #A7F3D0; padding:6px 12px; border-radius:6px; font-size:12px; font-weight:700;">
                  ✓ Atualização
                </span>
              </div>
              {{/if}}

              <p style="font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9CA3AF; margin:0 0 2px 0;">
                Título do comunicado
              </p>

              <h1 style="font-size:26px; line-height:32px; font-weight:800; margin:0 0 16px 0; color:#111827;">
                {{title}}
              </h1>

              <p style="font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9CA3AF; margin:0 0 2px 0;">
                Descrição
              </p>

              <p style="font-size:16px; line-height:26px; color:#4B5563; margin:0 0 28px 0;">
                {{description}}
              </p>

              <table width="100%" style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px;">
                <tr>
                  <td style="padding:24px;">
                    <table width="100%">
                      <tr>
                        <td class="stack" width="50%" style="padding-right:12px; vertical-align:top;">
                          <p style="font-size:11px; color:#64748B; font-weight:700; text-transform:uppercase;">Autor</p>
                          <p style="font-size:14px; font-weight:600; margin-top:4px;">{{author.name}}</p>
                          <p style="font-size:12px; color:#64748B;">{{author.role.key}}</p>

                          <div style="height:16px;"></div>

                          <p style="font-size:11px; color:#64748B; font-weight:700; text-transform:uppercase;">Setor</p>
                          <p style="font-size:14px; margin-top:4px;">{{sector.name}}</p>
                        </td>

                        <td class="stack" width="50%" style="vertical-align:top;">
                          <p style="font-size:11px; color:#64748B; font-weight:700; text-transform:uppercase;">Data</p>
                          <p style="font-size:14px; margin-top:4px;">{{createdAt}}</p>

                          <div style="height:16px;"></div>

                          <p style="font-size:11px; color:#64748B; font-weight:700; text-transform:uppercase;">Contato</p>
                          <a href="mailto:{{author.email}}" style="font-size:14px; color:#10b981; text-decoration:none; font-weight:600;">
                            {{author.email}}
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background:#F9FAFB; padding:20px; text-align:center; border-top:1px solid #E5E7EB;">
              <p style="margin:0 0 6px 0; font-size:13px; font-weight:600; color:#374151;">
                Antonelly Construções e Serviços
              </p>
              <p style="margin:0; font-size:12px; color:#9CA3AF;">
                © {{year}} • Este é um e-mail automático. Por favor, não responda.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
