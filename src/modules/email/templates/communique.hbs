<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <title>{{title}}</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 24px;">
        <!-- Container -->
        <table width="600" cellpadding="0" cellspacing="0"
          style="background:#ffffff; border-radius:6px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="padding:16px 24px; background:#1f2937; color:#ffffff;">
              <h2 style="margin:0; font-size:18px;">
                Comunicado — {{severity}}
              </h2>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:24px;">
              <h1 style="margin-top:0; font-size:22px; color:#111827;">
                {{#if isUpdate}}
                <small style="font-size:12px; color:#414753;">&lt;Atualização de Comunicado&gt;</small>
                <br />
                {{/if}}
                {{title}}
              </h1>
              <p style="font-size:14px; color:#374151; line-height:1.6;">
                {{description}}
              </p>

              <hr style="border:none; border-top:1px solid #e5e7eb; margin:24px 0;" />

              <!-- Metadata -->
              <p style="font-size:12px; color:#6b7280; margin:4px 0;">
                <strong>Setor:</strong> {{sector.name}}
              </p>

              <p style="font-size:12px; color:#6b7280; margin:4px 0;">
                <strong>Autor:</strong> {{author.name}} ({{author.role.key}})
              </p>

              <p style="font-size:12px; color:#6b7280; margin:4px 0;">
                <strong>Email:</strong> {{author.email}}
              </p>

              <p style="font-size:12px; color:#6b7280; margin:4px 0;">
                <strong>Data:</strong> {{createdAt}}
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:16px 24px; background:#f9fafb; text-align:center;">
              <p style="font-size:11px; color:#9ca3af; margin:0;">
                Este é um e-mail automático. Por favor, não responda.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>

</html>