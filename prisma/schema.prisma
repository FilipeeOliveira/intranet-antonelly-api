generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // ADMIN, GERENTE, PADRAO
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  roleFeatures RoleFeature[]

  @@map("roles")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   Document[]
  users       User[]
  communiques Communique[]

  @@map("sectors")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  username            String?  @unique
  password            String
  sectorId            String
  roleId              String
  isActive            Boolean  @default(true)
  isTemporaryPassword Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sector      Sector           @relation(fields: [sectorId], references: [id])
  role        Role             @relation(fields: [roleId], references: [id])
  permissions UserPermission[]
  blacklistedTokens BlacklistedToken[]
  communiques       Communique[]
  createdConstructions   Construction[]       @relation("ConstructionCreator")

  @@map("users")
}

model Page {
  id       String    @id @default(uuid())
  name     String    @unique
  features Feature[]

  @@map("pages")
}

model Feature {
  id           String           @id @default(uuid())
  prettyName   String? // ex: View Products, Create Product
  key          String           @unique // ex: VIEW_PRODUCTS, CREATE_PRODUCT
  description  String?
  hidden       Boolean          @default(false)
  pageId       String
  page         Page             @relation(fields: [pageId], references: [id])
  users        UserPermission[]
  roleFeatures RoleFeature[]

  @@map("features")
}

model UserPermission {
  id        String @id @default(uuid())
  userId    String
  featureId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([userId, featureId])
  @@map("user_permissions")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("blacklisted_tokens")
}

model Document {
  id          String   @id @default(uuid())
  title       String
  sectorId    String
  description String?
  filePath    String
  version     String
  versionNote String?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sector Sector @relation(fields: [sectorId], references: [id])

  documentHistories DocumentHistory[]

  @@map("documents")
}

model DocumentHistory {
  id          String   @id @default(uuid())
  documentId  String
  title       String
  description String?
  filePath    String
  version     String
  versionNote String?
  status      String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@map("documents_history")
}

model Companie {
  id          String   @id @default(uuid())
  name        String   @unique
  cnpj        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visitHistories VisitHistory[]

  @@map("companies")
}

model VisitHistory {
  id          String  @id @default(uuid())
  isScheduled Boolean @default(false)
  description String? // Motivo da visita
  name        String
  cpf         String?
  phone       String?
  companyId   String?
  status      Int     @default(1) // 1 = Agendado, 2 = Presente, 3 = Saiu, 4 = Cancelada.

  arrivedAt DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  signature String?   @db.Text
  signedAt  DateTime? @db.Timestamptz

  companie Companie? @relation(fields: [companyId], references: [id])

  @@map("visit_history")
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingSchedules MeetingSchedule[]

  @@map("rooms")
}

model MeetingSchedule {
  id            String    @id @default(uuid())
  subject       String
  description   String?
  sector        String?   // Setor digitado livremente (texto simples)
  responsible   String?   // Responsável digitado livremente (texto simples)
  date          DateTime  // Somente data
  startTime     String    // Horário agendado HH:MM
  endTime       String    // Horário agendado HH:MM
  actualStartAt DateTime? // Horário real de início (preenchido no start manual)
  actualEndAt   DateTime? // Horário real de fim (preenchido no finish manual ou cron)
  roomId        String
  status        Int       @default(1) // 1 = agendada, 2 = em andamento, 3 = concluida, 4 = cancelada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Room      Room     @relation(fields: [roomId], references: [id])

  @@map("meeting_schedule")
}

model Communique {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String
  imagePath   String?
  imageUrl    String?
  authorId    String?
  sectorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sector Sector @relation(fields: [sectorId], references: [id])
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("communiques")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notifications")
}

model RoleFeature {
  id        String @id @default(uuid())
  roleId    String
  featureId String

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, featureId])

  @@map("role_features")
}

enum OrderType {
  PACKAGE
  LETTER
  DOCUMENT
  PARCEL
  OTHER
}

enum OrderStatus {
  AWAITING_PICKUP
  DELIVERED
  RETURNED
}

model Order {
  id                  String      @id @default(uuid())
  protocolNumber      String      @unique
  type                OrderType   @default(PACKAGE)
  sender              String?     @db.VarChar(255)
  carrier             String?     @db.VarChar(255)
  trackingCode        String?     @db.VarChar(255)
  description         String?     @db.Text
  recipientName       String      @db.VarChar(255)
  recipientDepartment String?     @db.VarChar(255)
  recipientEmail      String      @db.VarChar(255)
  receivedAt          DateTime
  receivedBy          String      @db.VarChar(255)
  status              OrderStatus @default(AWAITING_PICKUP)
  deliveredAt         DateTime?
  deliveredTo         String?     @db.VarChar(255)
  deliveredBy         String?     @db.VarChar(255)
  notes               String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("orders")
}

// ─── Constructions ────────────────────────────────────────────────────────────

enum ConstructionStatus {
  planning
  in_progress
  paused
  completed
  cancelled
}

enum ConstructionCategory {
  OBRAS
  IP4
  PORTOS
  DSM
}

model Construction {
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  createdBy       String               @map("created_by")

  name            String
  category        ConstructionCategory @default(OBRAS)
  description     String?
  address         String?
  client          String?
  responsible     String?
  startDate       DateTime             @map("start_date")
  expectedEndDate DateTime             @map("expected_end_date")
  actualEndDate   DateTime?            @map("actual_end_date")
  contractValue   Decimal?             @map("contract_value") @db.Decimal(14, 2)
  status          ConstructionStatus   @default(planning)
  imageUrl        String?              @map("image_url")

  creator         User                 @relation("ConstructionCreator", fields: [createdBy], references: [id])
  @@map("constructions")
}
