generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // ADMIN, GERENTE, PADRAO
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents       Document[]
  users           User[]
  MeetingSchedule MeetingSchedule[]

  @@map("sectors")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  username            String?  @unique
  password            String
  sectorId            String
  roleId              String
  isActive            Boolean  @default(true)
  isTemporaryPassword Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sector            Sector             @relation(fields: [sectorId], references: [id])
  role              Role               @relation(fields: [roleId], references: [id])
  meetings          MeetingSchedule[]
  permissions       UserPermission[]
  blacklistedTokens BlacklistedToken[]

  @@map("users")
}

model Page {
  id       String    @id @default(uuid())
  name     String    @unique
  features Feature[]

  @@map("pages")
}

model Feature {
  id          String           @id @default(uuid())
  prettyName  String? // ex: View Products, Create Product
  key         String           @unique // ex: VIEW_PRODUCTS, CREATE_PRODUCT
  description String?
  pageId      String
  page        Page             @relation(fields: [pageId], references: [id])
  users       UserPermission[]

  @@map("features")
}

model UserPermission {
  id        String @id @default(uuid())
  userId    String
  featureId String

  user    User    @relation(fields: [userId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([userId, featureId])
  @@map("user_permissions")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("blacklisted_tokens")
}

model Document {
  id          String   @id @default(uuid())
  title       String
  sectorId    String
  description String?
  filePath    String
  version     String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sector Sector @relation(fields: [sectorId], references: [id])

  documentHistories DocumentHistory[]

  @@map("documents")
}

model DocumentHistory {
  id          String   @id @default(uuid())
  documentId  String
  title       String
  description String?
  filePath    String // caminho do arquivo antigo
  version     String
  status      String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@map("documents_history")
}

model Companie {
  id          String   @id @default(uuid())
  name        String   @unique
  cnpj        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visitHistories VisitHistory[]

  @@map("companies")
}

model VisitHistory {
  id          String  @id @default(uuid())
  isScheduled Boolean @default(false)
  description String? // Motivo da visita
  name        String
  cpf         String?
  phone       String?
  companyId   String?
  status      Int     @default(1) // 1 = Agendado, 2 = Presente, 3 = Saiu, 4 = Cancelada.

  arrivedAt DateTime  @default(now())
  leftAt    DateTime?

  companie Companie? @relation(fields: [companyId], references: [id])

  @@map("visit_history")
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingSchedules MeetingSchedule[]

  @@map("rooms")
}

model MeetingSchedule {
  id            String   @id @default(uuid())
  subject       String
  description   String?
  date          DateTime // Somente data
  startTime     String // Somente horário em HH:MM
  endTime       String // HH:MM calculado
  sectorId      String
  roomId        String
  responsibleId String?
  status        Int      @default(1) // 1 = agendada, 2 = em andamento, 3 = concluida, 4 = cancelada

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Sector      Sector   @relation(fields: [sectorId], references: [id])
  Room        Room     @relation(fields: [roomId], references: [id])
  Responsible User?    @relation(fields: [responsibleId], references: [id])

  @@map("meeting_schedule")
}
