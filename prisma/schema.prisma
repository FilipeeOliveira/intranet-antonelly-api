generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // ADMIN, GERENTE, PADRAO
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  username            String?  @unique
  password            String
  setor               String?
  roleId              String
  isActive            Boolean  @default(true)
  isTemporaryPassword Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  role              Role               @relation(fields: [roleId], references: [id])
  permissions       UserPermission[]
  blacklistedTokens BlacklistedToken[]

  @@map("users")
}

model Page {
  id       String    @id @default(uuid())
  name     String    @unique
  features Feature[]

  @@map("pages")
}

model Feature {
  id          String           @id @default(uuid())
  key         String           @unique // ex: VIEW_PRODUCTS, CREATE_PRODUCT
  description String?
  pageId      String
  page        Page             @relation(fields: [pageId], references: [id])
  users       UserPermission[]

  @@map("features")
}

model UserPermission {
  id        String @id @default(uuid())
  userId    String
  featureId String

  user    User    @relation(fields: [userId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([userId, featureId])
  @@map("user_permissions")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("blacklisted_tokens")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]

  @@map("sectors")
}

model Document {
  id          String   @id @default(uuid())
  title       String
  sectorId    String
  description String?
  filePath    String
  version     String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sector Sector @relation(fields: [sectorId], references: [id])

  @@map("documents")
}

model Companie {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visitors Visitor[]

  @@map("companies")
}

model Visitor {
  id         String  @id @default(uuid())
  name       String
  email      String  @unique
  companieId String?
  status     String?

  companie Companie? @relation(fields: [companieId], references: [id], onDelete: SetNull)

  histories VisitHistory[]

  @@map("visitors")
}

model VisitHistory {
  id        String    @id @default(uuid())
  visitorId String
  arrivedAt DateTime  @default(now())
  leftAt    DateTime?

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@map("visit_history")
}

model MeetingSchedule {
  id           String          @id @default(uuid())
  subject      String
  date         DateTime // somente data
  time         String // somente horário em HH:MM
  endTime      String // HH:MM calculado
  duration     MeetingDuration
  participants String // nomes separados por vírgula
  type         MeetingType
  priority     MeetingPriority
  location     String
  description  String?
  reminder     MeetingReminder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meeting_schedule")
}

enum MeetingDuration {
  MIN_15
  MIN_30
  MIN_45
  H_1
  H_1_30
  H_2
  H_3
}

enum MeetingType {
  INLOCAL
  ONLINE
}

enum MeetingPriority {
  LOW
  MID
  HIGH
  URGENT
}

enum MeetingReminder {
  NOT
  MIN_5
  MIN_15
  MIN_30
  H_1
  D_1
}
